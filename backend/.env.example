DATABASE_URL=sqlite:///./leetcode_streaks.local.db
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Google OAuth (authorization code flow with PKCE). Get these from
# https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client IDs
# (type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where Google redirects after consent. Must match the registered redirect URI
# exactly. Defaults to {FRONTEND_URL}/auth/callback. If the frontend is served
# under a sub-path (e.g. https://host/leetcode-streaks/), use:
#   GOOGLE_REDIRECT_URI=https://host/leetcode-streaks/auth/callback
GOOGLE_REDIRECT_URI=

# LeetCode account verification
LEETCODE_VERIFY_WINDOW_MINUTES=15
LEETCODE_VERIFY_COOLDOWN_SECONDS=12
LEETCODE_VERIFY_MAX_ATTEMPTS=10
LEETCODE_VERIFY_PROBLEM_SLUG=two-sum
